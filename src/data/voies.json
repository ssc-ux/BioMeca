  "etapes": [
   {
    "id": "production",
    "phase": "physiologie",
    "titre": "Production du TNF",
    "texte": "Le TNF est produit surtout par les macrophages activés. Il est d'abord exprimé à la membrane, puis libéré sous forme soluble (trimère) par l'enzyme TACE. Les deux formes sont actives.",
    "actifs": [
     "source",
     "tnf"
    ]
   },
   {
    "id": "recepteurs",
    "phase": "physiologie",
    "titre": "Deux récepteurs",
    "texte": "Le TNF se fixe sur TNFR1, exprimé par presque toutes les cellules, et sur TNFR2, exprimé surtout par les cellules immunitaires et endothéliales.",
    "actifs": [
     "source",
     "tnf",
     "tnfr1",
     "tnfr2"
    ]
   },
   {
    "id": "complexe",
    "phase": "physiologie",
    "titre": "Complexe de signalisation",
    "texte": "TNFR1 activé recrute les protéines adaptatrices TRADD, TRAF2 et RIPK1. TNFR2 recrute directement TRAF2.",
    "actifs": [
     "source",
     "tnf",
     "tnfr1",
     "tnfr2",
     "complexe",
     "traf2"
    ]
   },
   {
    "id": "voies",
    "phase": "physiologie",
    "titre": "NF-κB, MAP kinases, apoptose",
    "texte": "Ce complexe active IKK, qui libère NF-κB, et les MAP kinases, qui activent AP-1. Dans certaines conditions, TNFR1 déclenche au contraire l'apoptose par FADD et la caspase 8.",
    "actifs": [
     "source",
     "tnf",
     "tnfr1",
     "tnfr2",
     "complexe",
     "traf2",
     "nfkb",
     "mapk",
     "caspase"
    ]
   },
   {
    "id": "effets",
    "phase": "physiologie",
    "titre": "Réponse inflammatoire",
    "texte": "NF-κB et AP-1 activent la transcription de cytokines (IL-1, IL-6), de chimiokines et de molécules d'adhésion qui recrutent les leucocytes. Le TNF est aussi nécessaire à la formation et au maintien des granulomes."
   },
   {
    "id": "fixation",
    "phase": "fixation",
    "titre": "Fixation du médicament",
    "texte": "Les anti-TNF captent le TNF avant qu'il n'atteigne ses récepteurs."
   },
   {
    "id": "aval",
    "phase": "aval",
    "titre": "Conséquences en aval",
    "texte": "TNFR1 et TNFR2 ne sont plus stimulés : NF-κB et AP-1 ne sont plus activés, la production de cytokines et le recrutement leucocytaire diminuent. Le maintien des granulomes est fragilisé."
   }
  ]
 },
