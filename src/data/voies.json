  "etapes": [
   {
    "id": "production",
    "phase": "physiologie",
    "titre": "Production de l'IL-6",
    "texte": "L'IL-6 est produite par les macrophages, les fibroblastes et les cellules endothéliales, en réponse à une infection ou à une lésion tissulaire.",
    "actifs": [
     "source",
     "il6"
    ]
   },
   {
    "id": "liaison",
    "phase": "physiologie",
    "titre": "Liaison à IL-6R",
    "texte": "L'IL-6 se fixe sur son récepteur IL-6R. Il existe sous forme membranaire (hépatocytes, leucocytes : signalisation classique) et sous forme soluble, qui permet d'atteindre des cellules dépourvues d'IL-6R membranaire (trans-signalisation).",
    "actifs": [
     "source",
     "il6",
     "il6r"
    ]
   },
   {
    "id": "gp130",
    "phase": "physiologie",
    "titre": "Recrutement de gp130",
    "texte": "Le complexe IL-6/IL-6R recrute deux molécules de gp130, la sous-unité qui transmet le signal. IL-6R seul ne signale pas.",
    "actifs": [
     "source",
     "il6",
     "il6r",
     "gp130"
    ]
   },
   {
    "id": "jak",
    "phase": "physiologie",
    "titre": "Activation des JAK",
    "texte": "Les kinases JAK1, JAK2 et TYK2, associées à gp130, s'activent et phosphorylent gp130. Une seconde voie, RAS / MAP kinases, est activée en parallèle.",
    "actifs": [
     "source",
     "il6",
     "il6r",
     "gp130",
     "jak",
     "mapk"
    ]
   },
   {
    "id": "stat3",
    "phase": "physiologie",
    "titre": "STAT3 et rétrocontrôle",
    "texte": "STAT3, phosphorylé par les JAK, se dimérise et migre dans le noyau où il active la transcription. Parmi les gènes induits, SOCS3 freine en retour les JAK : c'est le rétrocontrôle négatif de la voie.",
    "actifs": [
     "source",
     "il6",
     "il6r",
     "gp130",
     "jak",
     "mapk",
     "stat3",
     "noyau",
     "socs3"
    ]
   },
   {
    "id": "effets",
    "phase": "physiologie",
    "titre": "Effets biologiques",
    "texte": "Dans le foie : protéines de la phase aiguë (CRP, fibrinogène, SAA) et hepcidine, responsable de l'anémie inflammatoire. Ailleurs : fièvre, thrombocytose, différenciation des lymphocytes Th17 et des lymphocytes B en plasmocytes."
   },
   {
    "id": "fixation",
    "phase": "fixation",
    "titre": "Fixation du médicament",
    "texte": "Chaque médicament se fixe sur sa cible et empêche la formation du complexe IL-6/IL-6R/gp130."
   },
   {
    "id": "aval",
    "phase": "aval",
    "titre": "Conséquences en aval",
    "texte": "Sans complexe actif, gp130 n'est plus recruté : JAK et STAT3 ne sont plus activés et la transcription dépendante de l'IL-6 chute. La CRP se normalise et reste basse, même en cas d'infection."
   }
  ]
 },
