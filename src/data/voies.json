  "etapes": [
   {
    "id": "production",
    "phase": "physiologie",
    "titre": "Production de BAFF",
    "texte": "BAFF (aussi appelé BLyS) est une cytokine de la famille du TNF, produite par les monocytes, les macrophages et les cellules dendritiques.",
    "actifs": [
     "source",
     "baff"
    ]
   },
   {
    "id": "recepteurs",
    "phase": "physiologie",
    "titre": "Trois récepteurs",
    "texte": "BAFF se fixe sur trois récepteurs du lymphocyte B : BAFF-R, le principal sur les lymphocytes B naïfs, TACI et BCMA, ce dernier surtout exprimé par les plasmocytes.",
    "actifs": [
     "source",
     "baff",
     "baffr",
     "taci",
     "bcma"
    ]
   },
   {
    "id": "survie",
    "phase": "physiologie",
    "titre": "Signal de survie",
    "texte": "BAFF-R active la voie alterne de NF-κB, qui induit des gènes de survie comme Bcl-2.",
    "actifs": [
     "source",
     "baff",
     "baffr",
     "taci",
     "bcma",
     "nfkb2",
     "noyau"
    ]
   },
   {
    "id": "effets",
    "phase": "physiologie",
    "titre": "Effets biologiques",
    "texte": "Ce signal conditionne la survie et la maturation des lymphocytes B, puis leur différenciation en plasmocytes sécréteurs d'anticorps. Un excès de BAFF favorise la survie de lymphocytes B autoréactifs.",
    "actifs": [
     "source",
     "baff",
     "baffr",
     "taci",
     "bcma",
     "nfkb2",
     "noyau",
     "e1",
     "e2"
    ]
   },
   {
    "id": "cd20",
    "phase": "physiologie",
    "titre": "CD20, marqueur du lymphocyte B",
    "texte": "CD20 est une protéine membranaire exprimée du stade pré-B au lymphocyte B mature et mémoire. Elle est absente des cellules souches et des plasmocytes.",
    "actifs": [
     "cd20"
    ]
   },
   {
    "id": "fixation",
    "phase": "fixation",
    "titre": "Fixation du médicament",
    "texte": "Chaque médicament se fixe sur sa cible : BAFF soluble ou CD20 membranaire."
   },
   {
    "id": "aval",
    "phase": "aval",
    "titre": "Conséquences en aval",
    "texte": "Anti-BAFF : le lymphocyte B perd un signal de survie. Anti-CD20 : le lymphocyte B est détruit (déplétion B périphérique) ; les cellules souches reconstituent ensuite le compartiment B, et les plasmocytes déjà formés sont épargnés."
   }
  ]
 },
